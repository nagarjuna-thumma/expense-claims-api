{
  "realm": "expenses",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Can submit and view their own claims" },
      { "name": "manager", "description": "Can view and decide on anyone's claims" },
      { "name": "auditor", "description": "Can verify the audit log, cannot submit or decide claims" }
    ]
  },
  "clients": [
    {
      "clientId": "expenses-cli",
      "name": "Local development client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Employee",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["employee"]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Manager",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["employee", "manager"]
    },
    {
      "username": "carol",
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "Employee",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "realmRoles": ["employee"]
    },
    {
      "username": "dave",
      "email": "dave@example.com",
      "firstName": "Dave",
      "lastName": "Auditor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "dave", "temporary": false }],
      "realmRoles": ["auditor"]
    }
  ]
}
